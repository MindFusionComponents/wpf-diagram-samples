<Window x:Class="MindFusion.Diagramming.Wpf.Samples.CS.DecisionLayout.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:diag="http://mindfusion.eu/diagramming/wpf"
	Title="MindFusion.Diagramming Sample: Decision Layout"
	Height="768" Width="1024" Icon="/App.ico">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition Height="34" />
		</Grid.RowDefinitions>

		<diag:DiagramView
			HorizontalAlignment="Stretch"
			VerticalAlignment="Stretch">

			<diag:Diagram
				Name="diagram"
				LinkHeadShape="Triangle"
				LinkHeadShapeSize="3.5"
				BackBrush="White"
				DefaultShape="Rectangle">
				<diag:Diagram.Style>
					<Style TargetType="{x:Type diag:Diagram}">
						<Setter Property="FontFamily" Value="Arial" />
						<Setter Property="FontSize" Value="10" />
					</Style>
				</diag:Diagram.Style>
				<diag:Diagram.DiagramLinkStyle>
					<Style TargetType="{x:Type diag:DiagramLink}">
						<Setter Property="Brush" Value="#4169E1" />
						<Setter Property="TextBrush" Value="#00008B" />
						<Setter Property="FontWeight" Value="Bold" />
					</Style>
				</diag:Diagram.DiagramLinkStyle>
			</diag:Diagram>
		</diag:DiagramView>

		<StackPanel Orientation="Horizontal" Margin="5" Grid.Row="1">
			<Button Name="loadSample" Margin="0,0,4,0" Click="loadSample_Click">Load Sample</Button>
			<Button Name="layout" Margin="0,0,10,0" Click="layout_Click">Layout</Button>
			<Button Name="layoutRandomDiagram" Click="layoutRandomDiagram_Click">Layout Random Diagram</Button>
		</StackPanel>
	</Grid>

</Window>