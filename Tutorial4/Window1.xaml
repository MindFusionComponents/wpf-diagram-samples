<Window x:Class="MindFusion.Diagramming.Wpf.Samples.CS.Tutorial4.Window1"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:diag="http://mindfusion.eu/diagramming/wpf"
	xmlns:local="clr-namespace:MindFusion.Diagramming.Wpf.Samples.CS.Tutorial4"
	Loaded="Window_Loaded"
	Title="MindFusion.Diagramming Sample: Tutorial4" Height="768" Width="1024" Icon="/App.ico">

	<Grid>
		<Grid.Resources>
			<ResourceDictionary>
				<BitmapImage x:Key="img1" UriSource="016.png" />
				<BitmapImage x:Key="img2" UriSource="ac0026-64.png" />
			</ResourceDictionary>
		</Grid.Resources>

		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition />
		</Grid.ColumnDefinitions>

		<diag:DiagramView
			x:Name="diagramView"
			AllowDrop="True"
			Grid.Column="1">

			<diag:Diagram
				x:Name="diagram"
				Bounds="0, 0, 1000, 1000"
				BackBrush="White"
				NodeCreated="OnNodeCreated"
				ShapeBrush="LightBlue"
				DefaultShape="Rectangle">
			</diag:Diagram>
		</diag:DiagramView>

		<StackPanel Orientation="Vertical">
			<Button Name="btnSave" Content="Save" Click="btnSaveClick" />
			<Button Name="btnLoad" Content="Load" Click="btnLoadClick" />
			<Button Name="btnUndo" Content="Undo" Click="btnUndoClick" />
			<Button Name="btnRedo" Content="Redo" Click="btnRedoClick"  />

			<diag:NodeListView Width="150">
				<local:OrgChartNode
					Bounds="0,0,140,70"
					Title="CEO" FullName="Type here"
					Text="Chief executive officer"
					Image="{StaticResource img1}"
					 />
				<local:OrgChartNode
					Bounds="0,0,140,70"
					Title="CIO" FullName="Type here"
					Text="Chief information officer"
					Image="{StaticResource img2}"
					 />
			</diag:NodeListView>

		</StackPanel>
	</Grid>

</Window>