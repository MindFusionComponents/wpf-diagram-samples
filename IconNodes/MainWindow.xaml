<Window x:Class="MindFusion.Diagramming.Wpf.Samples.CS.IconNodes.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:diag="http://mindfusion.eu/diagramming/wpf"
	Title="MindFusion.Diagramming Sample: Icon Nodes" Height="768" Width="1024" Icon="/App.ico">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition />
		</Grid.RowDefinitions>

		<Menu>
			<MenuItem Header="_File">
				<MenuItem Header="_Save..." Click="OnSaveClick" />
				<MenuItem Header="_Load..." Click="OnLoadClick" />
			</MenuItem>
		</Menu>
		<diag:DiagramView x:Name="diagramView" Grid.Row="1">
			<diag:Diagram
				x:Name="diagram"
				AlignToGrid="False"
				BackBrush="White"
				NodeDoubleClicked="diagram_NodeDoubleClicked"
				Clicked="diagram_Clicked" />
		</diag:DiagramView>
	</Grid>

</Window>
	