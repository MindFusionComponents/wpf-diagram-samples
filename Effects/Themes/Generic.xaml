<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:MindFusion.Diagramming.Wpf.Samples.CS.Effects">

	<local:ColorConverter x:Key="ColorConverter" />
	<local:VisibilityConverter x:Key="VisibilityConverter" />

	<VisualBrush x:Key="CheckeredBrush" ViewportUnits="Absolute" Viewport="0,0,20,20" TileMode="Tile">
		<VisualBrush.Visual>
			<Grid Width="20" Height="20">
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition />
					<RowDefinition />
				</Grid.RowDefinitions>
				<Rectangle Grid.Row="0" Grid.Column="0" Fill="LightGray" />
				<Rectangle Grid.Row="1" Grid.Column="0" Fill="White" />
				<Rectangle Grid.Row="1" Grid.Column="1" Fill="LightGray" />
				<Rectangle Grid.Row="0" Grid.Column="1" Fill="White" />
			</Grid>
		</VisualBrush.Visual>
	</VisualBrush>

	<Style TargetType="{x:Type local:ColorPicker}">
		<Setter Property="SelectedColor" Value="White" />
		<Setter Property="BorderBrush" Value="Gray" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type local:ColorPicker}">
					<Grid>
						<Border x:Name="root" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{StaticResource CheckeredBrush}">
							<Border Background="{Binding Path=SelectedColor, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ColorConverter}}" />
						</Border>
						<Popup Name="popup" StaysOpen="False" IsOpen="False">
							<Border BorderBrush="{x:Static SystemColors.ControlDarkBrush}" BorderThickness="1" Background="{x:Static SystemColors.ControlBrush}">
								<StackPanel Orientation="Vertical" Margin="5">
									<TextBlock Margin="0,0,0,2">Alpha:</TextBlock>
									<Slider Margin="0,0,0,5" Width="200" Minimum="0" Maximum="255" Name="alpha" />
									<TextBlock Margin="0,0,0,2">Red:</TextBlock>
									<Slider Margin="0,0,0,5" Width="200" Minimum="0" Maximum="255" Name="red" />
									<TextBlock Margin="0,0,0,2">Green:</TextBlock>
									<Slider Margin="0,0,0,5" Width="200" Minimum="0" Maximum="255" Name="green" />
									<TextBlock Margin="0,0,0,2">Blue:</TextBlock>
									<Slider Width="200" Minimum="0" Maximum="255" Name="blue" />
								</StackPanel>
							</Border>
						</Popup>
						<Border Background="#08000000" Visibility="{Binding IsEnabled, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource VisibilityConverter}, ConverterParameter='!'}" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

</ResourceDictionary>
