<Window x:Class="MindFusion.Diagramming.Wpf.Samples.CS.Controls.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mfc="clr-namespace:MindFusion.UI.Wpf;assembly=MindFusion.Common.Wpf"
    xmlns:mfd="clr-namespace:MindFusion.Diagramming.Wpf;assembly=MindFusion.Diagramming.Wpf"
    Title="MindFusion.Diagramming Sample: Controls" Height="768" Width="1024"
    Icon="/App.ico">

	<Grid x:Name="mainGrid">
		<Grid.ColumnDefinitions>
			<ColumnDefinition />
			<ColumnDefinition Width="200"/>
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition Height="200"/>
		</Grid.RowDefinitions>

		<GridSplitter Width="5" ShowsPreview="True" Background="Transparent" Grid.RowSpan="2" />


		<mfd:Ruler ShowIcon="False" FontSize="11" Grid.RowSpan="2" Margin="0,0,5,0">
			<mfd:DiagramView
				x:Name="diagramView"
				AllowDrop="True">

				<mfd:Diagram
					x:Name="diagram"
					Drop="diagram_Drop"
					DefaultShape="RoundRect">

					<mfd:ShapeNode StrokeThickness ="3"
						Shape="RoundRect"
						Bounds="200, 200, 350, 150"
						TextAlignment="Center"
						TextVerticalAlignment="Center"
						EnableStyledText="True"
						PolygonalTextLayout="True"
						FontFamily="Verdana" FontSize="14">
						<mfd:ShapeNode.Text>
							This sample demonstrates the auxiliary controls available with MindFusion.Diagramming for WPF:
							the &lt;b&gt;Overview&lt;/b&gt;, the &lt;b&gt;Ruler&lt;/b&gt;, the &lt;b&gt;ZoomControl&lt;/b&gt; and the &lt;b&gt;NodeListView&lt;/b&gt;.
						</mfd:ShapeNode.Text>
					</mfd:ShapeNode>
				</mfd:Diagram>
			</mfd:DiagramView>
		</mfd:Ruler>

		<mfc:ZoomControl
			x:Name="zoomControl"
            Target="{Binding ElementName=diagramView}"
			ScrollStep="40"
			MinZoomFactor="10"
			Height="350"
			VerticalAlignment="Top"
			Width="50"
			HorizontalAlignment="Left"
			Panel.ZIndex="1"
			Margin="30,30,0,0">
		</mfc:ZoomControl>

		<mfd:NodeListView
			x:Name="nodeListView"
			Grid.Column="1"
			SelectionChanged="nodeListView_SelectionChanged" 
			SnapsToDevicePixels="True"
			BorderBrush="#7E7E7E"
			BorderThickness="1">
		</mfd:NodeListView>

		<Border Grid.Row="1" Grid.Column="1"
				BorderBrush="#7E7E7E" BorderThickness="1,0,0,0">
			<mfd:Overview
				x:Name="overview"
				DiagramView="{Binding ElementName=diagramView}"
				DimBrush="Transparent" />
		</Border>
	</Grid>

</Window>
	