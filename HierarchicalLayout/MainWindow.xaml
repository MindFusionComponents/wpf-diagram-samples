<Window x:Class="MindFusion.Diagramming.Wpf.Samples.CS.HierarchicalLayout.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:diag="http://mindfusion.eu/diagramming/wpf"
	Title="MindFusion.Diagramming Sample: Hierarchical Layout"
	Height="768" Width="1024" Icon="/App.ico" WindowState="Maximized">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<diag:Ruler>
			<diag:DiagramView Behavior="DrawLinks">
				<diag:Diagram Name="diagram" />
			</diag:DiagramView>
		</diag:Ruler>
		<Grid Grid.Row="1" Height="40">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<Border Margin="5" BorderBrush="Gray" BorderThickness="1">
				<TextBlock>This example demonstrates the HierarchicalLayout class, which can be used to arrange level-planar graphs.</TextBlock>
			</Border>
			<Button Name="arrangeButton" Grid.Column="1" Margin="0,5,5,5" Content="Arrange" Width="100" Click="arrangeButton_Click" />
		</Grid>
	</Grid>

</Window>
