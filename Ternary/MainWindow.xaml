<Window x:Class="MindFusion.Diagramming.Wpf.Samples.CS.Ternary.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:diag="http://mindfusion.eu/diagramming/wpf"
	Title="MindFusion.Diagramming Sample: Ternary Connections"
	Height="768" Width="1024" Icon="/App.ico">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<diag:DiagramView
			ModificationStart="AutoHandles"
			Behavior="LinkShapes">

			<diag:Diagram
				x:Name="diagram"
				BackBrush="#FFF4F8FF"
				AllowSelfLoops="False" 
				AllowUnconnectedLinks="True"
				SelectAfterCreate="False"
				ContainerMinimumSize="0,0"
				AutoSnapLinks="True"
				AutoSnapDistance="10"
				ShapeBrush="White"
				ShapeHandlesStyle="HatchHandles"
				LinkCreated="diagram_LinkCreated"
				MouseMove="diagram_MouseMove"
				TableHandlesStyle="HatchHandles2"
				LinkBaseShape="Reversed"
				LinkShape="Polyline">

				<diag:Diagram.ShapeNodeStyle>
					<Style TargetType="{x:Type diag:ShapeNode}">
						<Setter Property="Brush" Value="White" />
						<Setter Property="StrokeThickness" Value="2" />
						<Setter Property="FontSize" Value="10.5" />
					</Style>
				</diag:Diagram.ShapeNodeStyle>
			</diag:Diagram>
		</diag:DiagramView>

		<Border Height="70" BorderBrush="Gray" BorderThickness="1" Grid.Row="1" Margin="2">
			<ScrollViewer>
				<TextBlock Margin="2" TextWrapping="Wrap">This example shows one possible method of implementing ternary connections with WpfDiagram: when drawing a link to another link, an intermediate node is created under the mouse and three helper links are created between the original nodes and the new intermediate node. This is implemented by enabling the AllowUnconnectedLinks property, which allows drawing links without connecting them to a node, and handling the LinkCreated event in order to create the intermediate node when un unconnected link is created.</TextBlock>
			</ScrollViewer>
		</Border>
	</Grid>

</Window>