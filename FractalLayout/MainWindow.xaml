<Window x:Class="MindFusion.Diagramming.Wpf.Samples.CS.FractalLayout.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:diag="http://mindfusion.eu/diagramming/wpf"
	Title="MindFusion.Diagramming Sample: Fractal Layout"
	Height="768" Width="1024" WindowState="Maximized" Icon="/App.ico">

	<Grid>
		<diag:DiagramView
			x:Name="diagramView"
			Behavior="Pan"
			LightweightPresenters="True"
			HorizontalAlignment="Stretch"
			VerticalAlignment="Stretch"
			PreviewMouseWheel="OnMouseWheel">

			<diag:Diagram Name="diagram"
				BackBrush="White"
				DefaultShape="Ellipse">
			</diag:Diagram>
		</diag:DiagramView>

		<Button Content="Random tree"
				Click="button_Click"
				Width="100" Height="60"
				Margin="0, 5, 21, 0"
				HorizontalAlignment="Right"
				VerticalAlignment="Top" />
	</Grid>

</Window>
	