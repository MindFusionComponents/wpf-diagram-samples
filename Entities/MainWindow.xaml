<Window x:Class="MindFusion.Diagramming.Wpf.Samples.CS.Entities.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:diag="http://mindfusion.eu/diagramming/wpf"
	Title="MindFusion.Diagramming Sample: Entities" Height="768" Width="1024" Icon="/App.ico">
	<Grid>
		<diag:DiagramView
			Behavior="LinkShapes"
			Margin="0,0,110,0">
			<diag:Diagram
				x:Name="diagram"
				NodeClicked="diagram_NodeClicked"
				AlignToGrid="False"
				BackBrush="WhiteSmoke"
				CrossingRadius="10"
				LinkCrossings="Arcs"
				LinkSegments="2"
				LinkShape="Cascading"
				RouteLinks="True" />
			</diag:DiagramView>
		<Button
			Margin="0,10,10,0"
			HorizontalAlignment="Right"
			VerticalAlignment="Top"
			Width="90" Height="40"
			Click="ButtonClick">Create</Button>
	</Grid>
</Window>
