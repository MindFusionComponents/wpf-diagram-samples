<Window x:Class="MindFusion.Diagramming.Wpf.Samples.CS.InteractiveTable.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:diag="http://mindfusion.eu/diagramming/wpf"
	Title="MindFusion.Diagramming Sample: Interactive Table"
	Width="1024" Height="768" Icon="/App.ico">

	<Grid>

		<diag:DiagramView
			x:Name="diagramView"
			Behavior="LinkTables"
			CreateEditControl="OnCreateEditControl"
			DestroyEditControl="OnDestroyEditControl">

			<diag:Diagram
				x:Name="diagram"
				Bounds="0,0,1000,1000"
				BackBrush="#FFF2FFDE"
				CellFrameStyle="Simple"
				TableColumnCount="1"
				TablesScrollable="True"
				NodeCreated="OnNodeCreated"
				CellClicked="OnCellClicked">
			</diag:Diagram>
		</diag:DiagramView>

	</Grid>

</Window>