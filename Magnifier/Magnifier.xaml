<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:diag="http://mindfusion.eu/diagramming/wpf"
	xmlns:sys="clr-namespace:System;assembly=mscorlib">

	<BitmapImage x:Key="image" UriSource="Glass.png" />

	<Style TargetType="{x:Type diag:Magnifier}" x:Key="Magnifier">
		<Setter Property="Width" Value="{Binding MagnifierWidth}"/>
		<Setter Property="Height" Value="{Binding MagnifierHeight}"/>
		<Setter Property="Background" Value="{Binding BackBrush}"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type diag:Magnifier}">
					<Grid>
						<Ellipse x:Name="PART_Background" Fill="{TemplateBinding Background}">
						</Ellipse>
						<Ellipse x:Name="PART_Lens"></Ellipse>
						<diag:DiagramPresenter x:Name="PART_Presenter" Visibility="Collapsed" />
						<Ellipse Margin="-4">
							<Ellipse.Fill>
								<ImageBrush ImageSource="{StaticResource image}" Viewport="0,0,1,1"/>
							</Ellipse.Fill>
						</Ellipse>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>