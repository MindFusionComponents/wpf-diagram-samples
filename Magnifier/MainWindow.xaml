<Window x:Class="MindFusion.Diagramming.Wpf.Samples.CS.Magnifier.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:diag="http://mindfusion.eu/diagramming/wpf"
	Title="MindFusion.Diagramming Sample: Magnifier"
	Height="768" Width="1024" Icon="/App.ico">

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition />
			<ColumnDefinition Width="200" />
		</Grid.ColumnDefinitions>

		<diag:DiagramView x:Name="diagramView">
			<diag:Diagram x:Name="diagram" />
		</diag:DiagramView>

		<StackPanel Grid.Column="1" Orientation="Vertical" Margin="5">
			<GroupBox Header="Enable Magnifier" Margin="0,0,0,10">
				<StackPanel Orientation="Vertical">
					<RadioButton x:Name="radioNever" Content="Never" Margin="0,0,0,2" IsChecked="True" Checked="radioNever_Checked" />
					<RadioButton x:Name="radioOnRightClick" Content="On right click" Margin="0,0,0,2" Checked="radioOnRightClick_Checked" />
					<RadioButton x:Name="radioOnAlt" Content="On ALT+click" Margin="0,0,0,2" Checked="radioOnAlt_Checked" />
					<RadioButton x:Name="radioAlways" Content="Always" Checked="radioAlways_Checked" />
				</StackPanel>
			</GroupBox>
			<GroupBox Header="Magnifier Appearance" Margin="0,0,0,10">
				<StackPanel Orientation="Vertical">
					<RadioButton x:Name="radioDefault" Content="Default" Margin="0,0,0,2" IsChecked="True" Checked="radioDefault_Checked" />
					<RadioButton x:Name="radioCustom" Content="Custom" Checked="radioCustom_Checked" />
				</StackPanel>
			</GroupBox>
			<TextBlock Text="Size:" />
			<Slider x:Name="sliderSize" Minimum="10" Maximum="300" Value="150" Margin="0,0,0,10" ValueChanged="sliderSize_ValueChanged" />
			<TextBlock Text="Zoom factor:" />
			<Slider x:Name="sliderZoom" Minimum="10" Maximum="300" Value="150" ValueChanged="sliderZoom_ValueChanged" />
		</StackPanel>

	</Grid>

</Window>
