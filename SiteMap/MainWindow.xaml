<Window x:Class="MindFusion.Diagramming.Wpf.Samples.CS.SiteMap.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:diag="http://mindfusion.eu/diagramming/wpf"
	Title="MindFusion.Diagramming Sample: Site Map"
	Height="768" Width="1024" Icon="/App.ico">

	<DockPanel>
		<Menu Height="22" Name="menu1" DockPanel.Dock="Top">
			<MenuItem Header="_File">
				<MenuItem Header="_New" Click="miNew_Click" />
				<MenuItem Header="_Load..." Click="miLoad_Click" />
				<MenuItem Header="_Save..." Click="miSave_Click" />
			</MenuItem>
			<MenuItem Header="_Tools">
				<MenuItem Header="_Generate pages" Click="miGenerate_Click" />
			</MenuItem>
			<MenuItem Header="E_xit" Click="miExit_Click" />
		</Menu>
		<diag:DiagramView>
			<diag:Diagram Name="siteMap"
                 LinkCreated="siteMap_LinkCreated"
                 NodeClicked="siteMap_NodeClicked"
                 NodeCreated="siteMap_NodeCreated"
                 NodeDeleting="siteMap_NodeDeleting"
                 SerializeTag="siteMap_SerializeTag"
                 DeserializeTag="siteMap_DeserializeTag"
                 AllowSelfLoops="False"
                 AllowUnconnectedLinks="True"
                 BackBrush="White"
                 ShapeHandlesStyle="HatchHandles3"
                 ShowGrid="False"
                 DynamicLinks="True">
				<diag:Diagram.ShapeNodeStyle>
					<Style TargetType="{x:Type diag:ShapeNode}">
						<Setter Property="Brush" Value="#C8DAEE" />
						<Setter Property="TextBrush" Value="Blue" />
						<Setter Property="FontSize" Value="11" />
					</Style>
				</diag:Diagram.ShapeNodeStyle>
			</diag:Diagram>
		</diag:DiagramView>
	</DockPanel>

</Window>
