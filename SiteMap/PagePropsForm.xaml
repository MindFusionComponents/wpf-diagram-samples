<Window x:Class="MindFusion.Diagramming.Wpf.Samples.CS.SiteMap.PagePropsForm"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="Page Properties" Height="300" Width="300">

	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="100" />
			<ColumnDefinition />
		</Grid.ColumnDefinitions>

		<TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Row="0" Margin="5,0">Title:</TextBlock>
		<TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Row="1" Margin="5,0">File name:</TextBlock>
		<TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Row="2" Margin="5,0">Image 1:</TextBlock>
		<TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Row="3" Margin="5,0">Image 2:</TextBlock>
		<TextBox Grid.Column="1" Grid.Row="0" Margin="2" Name="txTitle" />
		<TextBox Grid.Column="1" Grid.Row="1" Margin="2" Name="txFileName" />
		<TextBox Grid.Column="1" Grid.Row="2" Margin="2" Name="txImage1" />
		<TextBox Grid.Column="1" Grid.Row="3" Margin="2" Name="txImage2" />
		<Button Grid.Row="4" Grid.ColumnSpan="2" Name="button1" VerticalAlignment="Bottom" Width="100" IsDefault="True" Click="button1_Click">OK</Button>

	</Grid>

</Window>
