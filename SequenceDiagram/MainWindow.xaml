<Window x:Class="MindFusion.Diagramming.Wpf.Samples.CS.SequenceDiagram.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:diag="http://mindfusion.eu/diagramming/wpf"
	Title="MindFusion.Diagramming Sample: Sequence Diagram" Height="768" Width="1024" Icon="/App.ico">

	<Grid Name="mainGrid">
		<Grid.ColumnDefinitions>
			<ColumnDefinition />
			<ColumnDefinition Width="150"/>
		</Grid.ColumnDefinitions>

		<diag:DiagramView
			x:Name="diagramView"
			Behavior="DrawLinks"
			ModificationStart="AutoHandles"
			InplaceEditAcceptOnEnter="True"
			AllowDrop="True"
			DragOver="OnDragOver">

			<diag:Diagram
				x:Name="diagram"
				AllowSelfLoops="False"
				AllowLinksRepeat="False"
				SelectionOnTop="False"
				NodeCreated="OnNodeCreated"
				NodeModifying="OnNodeModifying"
				NodeModified="OnNodeModified"
				NodeDeleted="OnNodeDeleted"
				NodeDoubleClicked="OnNodeDoubleClicked"
				LinkCreated="OnLinkCreated"
				LinkCreating="OnLinkCreating"
				LinkDeleted="OnLinkDeleted"
				EnterInplaceEditMode="OnEnterInplaceEditMode" />
		</diag:DiagramView>

		<diag:NodeListView x:Name="nodeListView" Grid.Column="1" />

	</Grid>

</Window>
