<Window x:Class="MindFusion.Diagramming.Wpf.Samples.CS.MultiViews.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:ui="clr-namespace:MindFusion.UI.Wpf;assembly=MindFusion.Common.Wpf"
	xmlns:diag="http://mindfusion.eu/diagramming/wpf"
	Title="MindFusion.Diagramming Sample: Multi-Views"
	Height="768" Width="1024" Icon="/App.ico">

	<Grid Background="Gray" Name="mainGrid">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition />
		</Grid.RowDefinitions>
		<Menu Name="menu1" VerticalAlignment="Top">
			<MenuItem Header="_File" Name="myFile">
				<MenuItem Header="_Add" Name="myAdd" Click="myAdd_Click" />
				<MenuItem Header="_Remove" Name="myRemove" Click="myRemove_Click" />
			</MenuItem>
		</Menu>
		<ui:WindowHost Name="windowHost" Grid.Row="1" />
	</Grid>

</Window>
