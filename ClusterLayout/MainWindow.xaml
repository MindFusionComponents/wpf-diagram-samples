<Window x:Class="MindFusion.Diagramming.Wpf.Samples.CS.ClusterLayout.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:diag="http://mindfusion.eu/diagramming/wpf"
	Title="MindFusion.Diagramming Sample: Cluster Layout"
	Height="768" Width="1024" WindowState="Maximized" Icon="/App.ico">

	<Grid>
		<diag:DiagramView
			x:Name="diagramView"
			HorizontalAlignment="Stretch"
			VerticalAlignment="Stretch">

			<diag:Diagram
				Name="diagram"
				BackBrush="AliceBlue">

				<diag:Diagram.DiagramLinkStyle>
					<Style TargetType="{x:Type diag:DiagramLink}">
						<Setter Property="Brush" Value="Black" />
					</Style>
				</diag:Diagram.DiagramLinkStyle>
				<diag:Diagram.ShapeNodeStyle>
					<Style TargetType="{x:Type diag:ShapeNode}">
						<Setter Property="Brush" Value="#FFB0C4DE" />
					</Style>
				</diag:Diagram.ShapeNodeStyle>

			</diag:Diagram>

		</diag:DiagramView>
		<Button Content="Random graph"
				Click="button_Click"
				Width="100" Height="60"
				Margin="0, 5, 21, 0"
				HorizontalAlignment="Right"
				VerticalAlignment="Top" />
	</Grid>

</Window>
	