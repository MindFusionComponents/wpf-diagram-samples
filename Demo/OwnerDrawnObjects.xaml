<Page x:Class="MindFusion.Diagramming.Wpf.Samples.CS.Demo.OwnerDrawnObjects"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://mindfusion.eu/diagramming/wpf"
    xmlns:s="clr-namespace:System;assembly=mscorlib"
    Title="OwnerDrawObjects" Loaded="DemoPage_Loaded">
    <Page.Resources>
        <s:String x:Key="StepTitle">Owner-draw objects</s:String>
        <s:Int32 x:Key="StepIndex">15</s:Int32>
    </Page.Resources>
    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Visible" 
          VerticalScrollBarVisibility="Visible" 
          CanContentScroll="True" 
            Focusable="False"
            Grid.Row="0" 
            Margin="0,0,0,5">
            <d:Diagram Name="diagram" 
                   Bounds="0,0,200,200" 
                   >
            </d:Diagram>
        </ScrollViewer>
    </Grid>
</Page>
