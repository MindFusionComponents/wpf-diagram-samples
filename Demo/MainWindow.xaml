					<Separator />
					<MenuItem Name="mCut" Header="Cu_t" Click="mCut_Click" />
					<MenuItem Name="mCopy" Header="_Copy" Click="mCopy_Click" />
					<MenuItem Name="mPaste" Header="_Paste" Click="mPaste_Click" />
