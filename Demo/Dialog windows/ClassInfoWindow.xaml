<Window x:Class="MindFusion.Diagramming.Wpf.Samples.CS.Demo.ClassInfoWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ClassInfoWindow" Height="399" Width="457" ResizeMode="NoResize">
    <Grid>
        <Label Height="23" Width="42"
               HorizontalAlignment="Left" 
               Margin="7,20,0,0" 
               Name="lbName" 
               VerticalAlignment="Top">Name:</Label>
        <TextBox Height="21" 
                 Margin="62,17,0,0" 
                 Name="tBxName" 
                 VerticalAlignment="Top" HorizontalAlignment="Left" Width="154" />
        <Label Height="23" Width="112"
               Margin="7,51,0,0" 
               Name="lbBase" 
               VerticalAlignment="Top" 
               HorizontalAlignment="Left">Base classes:</Label>
        <ListBox HorizontalAlignment="Left" 
                 Margin="7,72,0,0" 
                 Name="lBxBase" 
                 Width="209" Height="82" VerticalAlignment="Top" />
        <Label Height="23" Margin="220,51,0,0" 
               Name="lbDerived" Width="180"
               VerticalAlignment="Top" 
               HorizontalAlignment="Left" >Derived classes:</Label>
        <ListBox Margin="224,72,0,0" Name="lBxDerived" Height="82" VerticalAlignment="Top" HorizontalAlignment="Left" Width="208"/>
        <Label HorizontalAlignment="Left" Margin="7,168,0,0" Name="lbMethods" Width="209" Height="23" VerticalAlignment="Top">Methods:</Label>
        <Label HorizontalAlignment="Left" Margin="224,168,0,0" Name="lbProperty" Width="120" Height="23" VerticalAlignment="Top">Proprties:</Label>
        <ListBox Height="98" HorizontalAlignment="Left" Margin="7,191,0,0" Name="lBxMethods" VerticalAlignment="Top" Width="183" SelectionMode="Single" SelectionChanged="lBxMethods_SelectionChanged" />
        <ListBox Margin="224,191,0,0" Name="lBxProperty" SelectionMode="Single" SelectionChanged="lBxProperty_SelectionChanged" Height="96" VerticalAlignment="Top" HorizontalAlignment="Left" Width="180" />
        <Button Margin="192,191,0,0" Name="btnAddMethod" Click="btnAddMethod_Click" Height="24" VerticalAlignment="Top" HorizontalAlignment="Left" Width="24">
            <Image Name="imgBtn1" Source="/Files/Resources/plus.bmp" />
        </Button>
        <Button HorizontalAlignment="Left" Margin="192,215,0,0" Name="btnRemoveMethod" Width="24" Click="btnRemoveMethod_Click" Height="24" VerticalAlignment="Top">
            <Image Name="imgBtn2" Source="/Files/Resources/del.bmp" />
        </Button>
        <Button Height="24" HorizontalAlignment="Left" Margin="192,239,0,0" VerticalAlignment="Top" Width="24" Name="btnUpMethod" Click="btnUpMethod_Click">
            <Image Name="imgBtn3" Source="/Files/Resources/up.bmp" />
        </Button>
        <Button HorizontalAlignment="Left" Margin="192,263,0,0" Width="24" Name="btnDownMethod" Click="btnDownMethod_Click" Height="24" VerticalAlignment="Top">
            <Image Name="imgBtn4" Source="/Files/Resources/down.bmp" />
        </Button>
        <Button Margin="406,191,0,0" Name="btnAddProperty" Click="btnAddProperty_Click" Height="24" VerticalAlignment="Top" HorizontalAlignment="Left" Width="24">
            <Image Name="imgBtn5" Source="/Files/Resources/plus.bmp" />
        </Button>
        <Button Margin="406,263,0,0" Name="btnDownProperty" Click="btnDownProperty_Click" Height="24" VerticalAlignment="Top" HorizontalAlignment="Left" Width="24">
            <Image Name="imgBtn6" Source="/Files/Resources/down.bmp" />
        </Button>
        <Button Margin="406,239,0,0" Name="btnUpProperty" Height="24" VerticalAlignment="Top" Click="btnUpProperty_Click" HorizontalAlignment="Left" Width="24">
            <Image Name="imgBtn7" Source="/Files/Resources/up.bmp" />
        </Button>
        <Button Margin="406,215,0,0" Name="btnRemoveProperty" Click="btnRemoveProperty_Click" HorizontalAlignment="Left" Width="24" Height="24" VerticalAlignment="Top">
            <Image Name="imgBtn8" Source="/Files/Resources/del.bmp" />
        </Button>
        <TextBox Height="21" HorizontalAlignment="Left" Margin="7,296,0,0" Name="tBxMethodEdit" VerticalAlignment="Top" Width="209" TextChanged="tBxMethodEdit_TextChanged"/>
        <TextBox Height="21" HorizontalAlignment="Left" Margin="224,295,0,0" Name="tBxPropertyEdit" VerticalAlignment="Top" Width="209" TextChanged="tBxPropertyEdit_TextChanged"/>
        <Button Height="23" Margin="141,0,0,10" Name="btnOk" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="75" Click="btnOk_Click">Ok</Button>
        <Button Height="23" HorizontalAlignment="Right" Margin="0,0,140,10" Name="btnCancel" VerticalAlignment="Bottom" Width="75" Click="btnCancel_Click">Cancel</Button>
    </Grid>
</Window>
