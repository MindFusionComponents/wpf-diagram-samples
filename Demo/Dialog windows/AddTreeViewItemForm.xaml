<Window x:Class="MindFusion.Diagramming.Wpf.Samples.CS.Demo.AddTreeViewItemForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Add Item" Height="265" Width="300">
    <Grid Height="259">
        <Label Height="23" Margin="12,12,0,0" Name="label1" VerticalAlignment="Top" HorizontalAlignment="Left" Width="48">Label</Label>
        <Label Height="23" Margin="12,41,0,0" Name="label2" VerticalAlignment="Top" HorizontalAlignment="Left" Width="48">Icon</Label>
        <Label Height="28" Margin="12,0,0,85" Name="label3" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="48">Color</Label>
        <TextBox Height="23" Margin="66,12,12,0" Name="_labelEdit" VerticalAlignment="Top" >Item</TextBox>
        <ListView Margin="66,41,12,120" Name="_iconList">
            <ListViewItem Height="20">
                <Grid>
                    <Image HorizontalAlignment="Left" Source="../Files/Resources/TreeIcons/1.png"></Image>
                    <TextBlock Margin="30, 0,0,0">1</TextBlock>
                </Grid>
            </ListViewItem>
            <ListViewItem Height="20">
                <Grid>
                    <Image HorizontalAlignment="Left" Source="/Files/Resources/TreeIcons/2.png"></Image>
                    <TextBlock Margin="30, 0,0,0">2</TextBlock>
                </Grid>
            </ListViewItem>
            <ListViewItem Height="20" >
                <Grid>
                    <Image HorizontalAlignment="Left" Source="/Files/Resources/TreeIcons/3.png"></Image>
                    <TextBlock Margin="30, 0,0,0">3</TextBlock>
                </Grid>
            </ListViewItem>
            <ListViewItem Height="20">
                <Grid>
                    <Image HorizontalAlignment="Left" Source="/Files/Resources/TreeIcons/4.png"></Image>
                    <TextBlock Margin="30, 0,0,0">4</TextBlock>
                </Grid>
            </ListViewItem>
        </ListView>
        <Button Height="23" Margin="101,0,101,50" Name="button1" VerticalAlignment="Bottom" Click="button1_Click" IsDefault="True">Add</Button>
        <Label Height="28" Margin="66,0,0,86" Name="label4" VerticalAlignment="Bottom" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
               HorizontalAlignment="Left" Width="21">R:</Label>
        <Label Height="28" HorizontalContentAlignment="Center" Margin="134,0,123,86" Name="label6" VerticalAlignment="Bottom" VerticalContentAlignment="Center">R:</Label>
        <Label Height="28" HorizontalAlignment="Right" HorizontalContentAlignment="Center" Margin="0,0,55,86" Name="label7" VerticalAlignment="Bottom" VerticalContentAlignment="Center" Width="21">R:</Label>
        <TextBox Height="23" Margin="85,0,0,91" Name="txBcolorR" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="45" >0</TextBox>
        <TextBox Height="23" HorizontalAlignment="Right" Margin="0,0,80,91" Name="txBcolorG" VerticalAlignment="Bottom" Width="45" >0</TextBox>
        <TextBox Height="23" HorizontalAlignment="Right" Margin="0,0,12,91" Name="txBcolorB" VerticalAlignment="Bottom" Width="45" >0</TextBox>
    </Grid>
</Window>
