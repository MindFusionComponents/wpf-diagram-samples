<Window x:Class="MindFusion.Diagramming.Wpf.Samples.CS.Demo.AddTableWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Add Table" Height="127" Width="298">
    <Grid>
        <Label Width="79" Height="23" 
               Margin="10,12,0,0" 
               Name="lbTableName" 
               VerticalAlignment="Top" 
               HorizontalAlignment="Left">Table name:</Label>
        <TextBox Height="21" Width="155"
                 Margin="0,14,16,0" 
                 Name="tBxTableName" 
                 VerticalAlignment="Top" 
                 HorizontalAlignment="Right"  />
        <Button Width="76" Height="23"
                Margin="53,52,0,0" 
                Name="btnOk" 
                HorizontalAlignment="Left" 
                VerticalAlignment="Top"
								IsDefault="True"
                Click="btnOk_Click">OK</Button>
        <Button Width="75" Height="23"
                HorizontalAlignment="Left" 
                Margin="141,52,0,0" 
                Name="btnCancel"  
                VerticalAlignment="Top"
                Click="btnCancel_Click">Cancel</Button>
    </Grid>
</Window>
