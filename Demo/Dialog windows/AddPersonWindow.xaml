<Window x:Class="MindFusion.Diagramming.Wpf.Samples.CS.Demo.AddPersonWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AddPersonWindow" Height="136" Width="327">
    <Grid>
        <Border BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left" Margin="3,3,0,0" Width="73" Height="90" >
            <Image Margin="0,0,0,0" Name="pictureBox" 
               MouseLeftButtonDown="pictureBox_MouseLeftButtonDown">
            </Image>
        </Border>
        <Label Height="23" Margin="85,3,0,0" Name="lbName" VerticalAlignment="Top" HorizontalAlignment="Left" Width="72">Name:</Label>
        <Label Margin="85,31,0,0" Name="label2" HorizontalAlignment="Left" Width="72" Height="23" VerticalAlignment="Top">Birth/Death:</Label>
        <TextBox Height="21" HorizontalAlignment="Right" Margin="0,3,3,0" Name="tBxNameEdit" VerticalAlignment="Top" Width="135" />
        <TextBox HorizontalAlignment="Right" Margin="0,31,4,0" Name="tBxBirthDeathEdit" Width="134" Height="21" VerticalAlignment="Top" />
        <Button Height="23" HorizontalAlignment="Right" Margin="0,0,4,2.5" Name="btnAdd" VerticalAlignment="Bottom" Width="75" Click="btnAdd_Click">Add</Button>
        <Button Height="23" Margin="82,0,148,3.5" Name="btnBrowse" VerticalAlignment="Bottom" Click="btnBrowse_Click">Browse</Button>
    </Grid>
</Window>
