<Window x:Class="MindFusion.Diagramming.Wpf.Samples.CS.Demo.TourForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="TourForm" Height="330" Width="307">
    <Grid Height="300" Width="300" Background="#FFE0DFE3" MaxWidth="307" MaxHeight="330">
        <TextBox Name="descEdit" Height="122" VerticalAlignment="Top" Background="#FFE0DFE3" FontFamily="Times New Roman" FontSize="12" IsReadOnly="True" TextWrapping="Wrap" />
        <ListBox Margin="0,121,0,53" Background="LemonChiffon" Name="optionsList" MouseDoubleClick="optionsList_MouseDoubleClick" FontSize="13" />
        <Button Margin="111,0,114,15" Name="btnEnd" Height="23" VerticalAlignment="Bottom" Click="btnEnd_Click">End</Button>
    </Grid>
</Window>
