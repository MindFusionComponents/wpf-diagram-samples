        <Label Margin="79,40,12,0" Name="label2" Height="28" VerticalAlignment="Top">Copyright (C) 2025 MindFusion LLC, Bulgaria</Label>
        <Image Margin="12,9,0,0" Name="image1" Stretch="Fill" Height="42" HorizontalAlignment="Left" VerticalAlignment="Top" Width="43" Source="/Demo;component/NetIco.ico" />
        <Label Height="28" HorizontalAlignment="Left" Margin="12,0,0,40" Name="label3" VerticalAlignment="Bottom" Width="120">Visit our web-site at:</Label>
        <Label Height="28" Margin="141,0,70,40" Name="label4" VerticalAlignment="Bottom">
            <Hyperlink Click="Hyperlink_Click" NavigateUri="https://www.mindfusion.eu" >www.mindfusion.eu</Hyperlink>
        </Label>
