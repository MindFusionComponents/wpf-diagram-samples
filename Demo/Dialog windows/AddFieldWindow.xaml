<Window x:Class="MindFusion.Diagramming.Wpf.Samples.CS.Demo.AddFieldWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Add Field" Height="167" Width="318">
    <Grid>
        <Label Width="79" Height="26" 
               Margin="10,12,0,0" 
               Name="lbFieldName" 
               VerticalAlignment="Top" 
               HorizontalAlignment="Left">Field name:</Label>
        <TextBox Height="21" Margin="125,14,16,0" 
                 Name="tBxFieldName" 
                 VerticalAlignment="Top" />
        <Label Width="79" Height="26" 
               Margin="10,42,0,0" 
               Name="lbFieldType" 
               VerticalAlignment="Top" 
               HorizontalAlignment="Left">Field type:</Label>
        <Button Width="76" Height="23"
                Margin="53,82,0,0" 
                Name="btnOk" 
                HorizontalAlignment="Left" 
                VerticalAlignment="Top"
								IsDefault="True"
                Click="btnOk_Click">OK</Button>
        <Button Width="75" Height="23"
                HorizontalAlignment="Left" 
                Margin="141,82,0,0" 
                Name="btnCancel"  
                VerticalAlignment="Top"
                Click="btnCancel_Click">Cancel</Button>
        <ComboBox Margin="125,44,17,64" Name="cmBxType" >
            <ComboBoxItem>Text</ComboBoxItem>
            <ComboBoxItem>Number</ComboBoxItem>
            <ComboBoxItem>Date/Time</ComboBoxItem>
            <ComboBoxItem>Auto number</ComboBoxItem>
            <ComboBoxItem>Yes/No</ComboBoxItem>
        </ComboBox>
    </Grid>
</Window>
