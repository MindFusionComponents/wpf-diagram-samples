<Page x:Class="MindFusion.Diagramming.Wpf.Samples.CS.Demo.FormDesigner"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://mindfusion.eu/diagramming/wpf"
	xmlns:s="clr-namespace:System;assembly=mscorlib"
	Title="FormDesigner" Loaded="Page_Loaded">
	<Page.Resources>
		<s:String x:Key="StepTitle">Form designer</s:String>
		<s:Int32 x:Key="StepIndex">-1</s:Int32>
	</Page.Resources>
	<Grid>
		<d:DiagramView x:Name="diagramView">
			<d:Diagram x:Name="diagram" BackBrush="#FFDCDCFF" Bounds="0,0,200,200" />
		</d:DiagramView>
	</Grid>
</Page>
