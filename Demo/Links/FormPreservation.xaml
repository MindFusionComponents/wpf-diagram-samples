<Page x:Class="MindFusion.Diagramming.Wpf.Samples.CS.Demo.FormPreservation"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://mindfusion.eu/diagramming/wpf"
	xmlns:s="clr-namespace:System;assembly=mscorlib"
	Title="Form preservation" Loaded="Page_Loaded">
	<Page.Resources>
		<s:String x:Key="StepTitle">Form preservation</s:String>
		<s:Int32 x:Key="StepIndex">25</s:Int32>
	</Page.Resources>
	<Grid>
		<d:Ruler Name="ruler">
			<d:DiagramView x:Name="diagramView">
				<d:Diagram x:Name="diagram" Bounds="0,0,200,200" />
			</d:DiagramView>
		</d:Ruler>
	</Grid>
</Page>
