<Window x:Class="MindFusion.Diagramming.Wpf.Samples.CS.FlowCharter.OptionsDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Height="328" Width="252" Title="Options" ResizeMode="NoResize" Loaded="Window_Loaded">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<StackPanel Orientation="Vertical" Margin="5">
			<CheckBox Name="_showGridCheck" Margin="2,5">Show grid</CheckBox>
			<Grid Margin="0,0,0,5">
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition Width="35" />
					<ColumnDefinition Width="35" />
					<ColumnDefinition Width="35" />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition />
					<RowDefinition />
					<RowDefinition />
					<RowDefinition />
				</Grid.RowDefinitions>
				<TextBlock Grid.Column="1" Margin="2">R</TextBlock>
				<TextBlock Grid.Column="2" Margin="2">G</TextBlock>
				<TextBlock Grid.Column="3" Margin="2">B</TextBlock>
				<TextBlock Grid.Row="1" VerticalAlignment="Center">Background brush:</TextBlock>
				<TextBlock Grid.Row="2" VerticalAlignment="Center">Node fill brush:</TextBlock>
				<TextBlock Grid.Row="3" VerticalAlignment="Center">Connector fill brush:</TextBlock>
				<TextBox Name="bBR" Grid.Column="1" Grid.Row="1" Margin="2" />
				<TextBox Name="bBG" Grid.Column="2" Grid.Row="1" Margin="2" />
				<TextBox Name="bBB" Grid.Column="3" Grid.Row="1" Margin="2" />
				<TextBox Name="nBR" Grid.Column="1" Grid.Row="2" Margin="2" />
				<TextBox Name="nBG" Grid.Column="2" Grid.Row="2" Margin="2" />
				<TextBox Name="nBB" Grid.Column="3" Grid.Row="2" Margin="2" />
				<TextBox Name="cBR" Grid.Column="1" Grid.Row="3" Margin="2" />
				<TextBox Name="cBG" Grid.Column="2" Grid.Row="3" Margin="2" />
				<TextBox Name="cBB" Grid.Column="3" Grid.Row="3" Margin="2" />
			</Grid>
			<GroupBox Header="Anchors">
				<Grid Margin="2" >
					<Grid.ColumnDefinitions>
						<ColumnDefinition />
						<ColumnDefinition Width="35" />
						<ColumnDefinition Width="35" />
						<ColumnDefinition Width="35" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition />
						<RowDefinition />
						<RowDefinition />
					</Grid.RowDefinitions>
					<CheckBox Name="_showAnchorsCheck" Grid.ColumnSpan="4" Margin="2,5">Show anchor</CheckBox>
					<Label Grid.Row="1">Anchor brush:</Label>
					<TextBox Name="aBR" Grid.Row="1" Grid.Column="1" Margin="2" />
					<TextBox Name="aBG" Grid.Row="1" Grid.Column="2" Margin="2" />
					<TextBox Name="aBB" Grid.Row="1" Grid.Column="3" Margin="2" />
					<Label Grid.Row="2">Anchor style:</Label>
					<Button Name="_circleBtn" Grid.Row="2" Grid.Column="1" Margin="2" Click="button1_Click">
						<Image Source="/FlowCharter;component/Icons/Circle.ico" Stretch="None" />
					</Button>
					<Button Name="_rectBtn" Grid.Row="2" Grid.Column="2" Margin="2" Click="button2_Click">
						<Image Source="/FlowCharter;component/Icons/Rect.ico" Stretch="None" />
					</Button>
					<Button Name="_xBtn" Grid.Row="2" Grid.Column="3" Margin="2" Click="button3_Click">
						<Image Source="/FlowCharter;component/Icons/X.ico" Stretch="None" />
					</Button>
				</Grid>
			</GroupBox>
		</StackPanel>

		<StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Orientation="Horizontal" Margin="5" Grid.Row="2">
			<Button Name="_okBtn" Click="_okBtn_Click" Margin="0,0,5,0" Width="75">Ok</Button>
			<Button Name="_cancelBtn" Click="_cancelBtn_Click" Width="75">Cancel</Button>
		</StackPanel>

	</Grid>

</Window>
