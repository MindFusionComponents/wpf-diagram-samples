<Window x:Class="MindFusion.Diagramming.Wpf.Samples.CS.Routing.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:diag="http://mindfusion.eu/diagramming/wpf"
	Title="MindFusion.Diagramming Sample: Link Routing"
	Height="768" Width="1024" Icon="/App.ico">

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition />
			<ColumnDefinition Width="Auto" />
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<diag:DiagramView>
			<diag:Diagram Name="diagram" BackBrush="White" />
		</diag:DiagramView>

		<StackPanel Grid.Column="1" Orientation="Vertical" Margin="10" Width="150">
			<TextBlock Name="turnCostLb" Margin="0,0,0,2">Turn cost:</TextBlock>
			<Slider Name="turnCostTrB" Margin="0,0,0,10" Maximum="200" TickFrequency="10" TickPlacement="BottomRight" SmallChange="1" LargeChange="5" ValueChanged="turnCostTrB_ValueChanged" />
			<TextBlock Name="crossingCostLb" Margin="0,0,0,2">Crossing cost:</TextBlock>
			<Slider Name="crossingCostTrB" Margin="0,0,0,10" Maximum="50" TickFrequency="5" TickPlacement="BottomRight" SmallChange="1" LargeChange="5" ValueChanged="crossingCostTrB_ValueChanged" />
			<TextBlock Name="lengthCostLb" Margin="0,0,0,2">Length cost:</TextBlock>
			<Slider Name="lengthCostTrB" Margin="0,0,0,10" Maximum="50" SmallChange="1" LargeChange="5" TickFrequency="5" TickPlacement="BottomRight" ValueChanged="lengthCostTrB_ValueChanged" />
			<TextBlock Name="nodeVicCostLb" Margin="0,0,0,2">Node visinity cost:</TextBlock>
			<Slider Name="nodeVicCostTrB" Margin="0,0,0,10" Maximum="50" LargeChange="5" SmallChange="1" TickFrequency="5" TickPlacement="BottomRight" ValueChanged="nodeVicCostTrB_ValueChanged" />
			<TextBlock Name="nodeVicSizeLb" Margin="0,0,0,2">Node vicinity size:</TextBlock>
			<Slider Name="nodeVicSizeTrB" Margin="0,0,0,10" Maximum="50" LargeChange="5" TickFrequency="5" SmallChange="1" TickPlacement="BottomRight" ValueChanged="nodeVicSizeTrB_ValueChanged" />
			<Button Name="rerouteAllArrowsBtn" Click="rerouteAllArrowsBtn_Click">Reroute all arrows</Button>
		</StackPanel>

		<Border Grid.Row="1" Grid.ColumnSpan="2" Height="70" BorderBrush="Gray" BorderThickness="1" Margin="2">
			<ScrollViewer>
				<TextBlock TextWrapping="Wrap" Margin="2">This example lets you experiment with the various arrow routing options. Move the sliders to alter a routing parameter value and draw arrows in the flowchart canvas on the left to see the effect of the new value. Each cost property is a penalty value added by the route evaluation algorithm to a route cost when a given condition is met. The turn cost is added if an arrow makes a turn when following the considered route. Crossing cost is added if an arrow crosses another arrow. Length cost is added for each piece of the routing grid an arrow passes through. Node vicinity cost is added to the total cost if the arrow passes near a node.</TextBlock>
			</ScrollViewer>
		</Border>

	</Grid>

</Window>