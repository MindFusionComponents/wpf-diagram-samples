<Window x:Class="MindFusion.Diagramming.Wpf.Samples.CS.Virtualization.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:diag="http://mindfusion.eu/diagramming/wpf"
	Title="MindFusion.Diagramming sample: Virtualization"
	Height="768" Width="1024" WindowState="Maximized" Icon="/App.ico" Loaded="OnLoaded">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="60" />
			<RowDefinition />
		</Grid.RowDefinitions>

		<Border BorderBrush="Gray" BorderThickness="1" Margin="2">
			<TextBlock TextWrapping="Wrap" Margin="2">
				This sample project demonstrates a DataBoundDiagram displaying 150000 data items.
				BindingMode is set to TwoWay, and any changes you do to the diagram elements will be reflected
				back to the data source.
			</TextBlock>
		</Border>

        <diag:DiagramView x:Name="diagramView"
			Grid.Row="1"
			Focusable="False"
			IsTabStop="False">

			<diag:DataBoundDiagram
				x:Name="diagram"
				BackBrush="White"
				NodeRealized="OnNodeRealized"
				LinkRealized="OnLinkRealized" />

		</diag:DiagramView>
	</Grid>

</Window>