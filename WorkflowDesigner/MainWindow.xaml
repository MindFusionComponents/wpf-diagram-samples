<Window x:Class="MindFusion.Diagramming.Wpf.Samples.CS.WorkflowDesigner.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:diag="http://mindfusion.eu/diagramming/wpf"
	Title="MindFusion.Diagramming Sample: Workflow Designer"
	Height="768" Width="1024" Icon="/App.ico">

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition />
			<ColumnDefinition Width="170" />
		</Grid.ColumnDefinitions>

		<diag:DiagramView
			x:Name="diagramView"
			AllowDrop="True">

			<diag:Diagram
				x:Name="diagram"
				BackBrush="White" />
		</diag:DiagramView>

		<StackPanel Grid.Column="1" Orientation="Vertical" Margin="10">
			<ListBox Name="palette" Height="400" MouseDown="palette_MouseDown" MouseMove="palette_MouseMove" Margin="0,0,0,10">
				<ListBoxItem>Activity</ListBoxItem>
				<ListBoxItem>IfElse</ListBoxItem>
				<ListBoxItem>While</ListBoxItem>
			</ListBox>
			<Button Name="btnNew" Click="btnNew_Click" Margin="0,0,0,5">_New</Button>
			<Button Name="btnLayout" Click="btnLayout_Click" Margin="0,0,0,5">L_ayout</Button>
			<Button Name="btnSave" Click="btnSave_Click" Margin="0,0,0,5">_Save</Button>
			<Button Name="btnLoad" Click="btnLoad_Click">_Load</Button>
		</StackPanel>

	</Grid>

</Window>