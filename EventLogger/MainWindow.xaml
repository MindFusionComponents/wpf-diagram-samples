<Window x:Class="MindFusion.Diagramming.Wpf.Samples.CS.EventLogger.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:diag="http://mindfusion.eu/diagramming/wpf"
	Title="MindFusion.Diagramming Sample: Event Logger" Height="687" Width="855" Icon="/App.ico">

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition />
			<ColumnDefinition Width="255"/>
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition Height="70"/>
		</Grid.RowDefinitions>

		<ListBox Grid.Column="1" Margin="5,5,5,100" Name="listBox1" />
		<CheckBox Grid.Column="1" Height="15" Margin="50,5,5,38" Name="checkBox1" VerticalAlignment="Bottom" >Log mouse events</CheckBox>
		<CheckBox Grid.Column="1" Height="15" Margin="50,5,5,16" Name="checkBox2" VerticalAlignment="Bottom">Log paint events</CheckBox>
		<Button Grid.Column="1"  Margin="5,5,5,70" Name="button1" VerticalAlignment="Bottom" Click="button1_Click">Clear Log</Button>
		<Button Grid.Column="1" Grid.Row="1"  Margin="5,10,5,0" Name="button2"  VerticalAlignment="Top" ContentStringFormat="" Click="button2_Click">LoadFromFile</Button>
		<Button Grid.Column="1" Grid.Row="1"  Margin="5,0,5,10" Name="button3"  VerticalAlignment="Bottom" Click="button3_Click">LoadFromXml</Button>
		<Border Grid.Row="1" Margin="5" Name="border1" BorderBrush="DimGray" BorderThickness="1">
			<TextBlock Text="This sample lets you find out what MindFusion.Diagramming events are raised while the user interacts with  the diagram. If you wonder what event is raised in response to a user's action, carry out that action in the diagram and watch out the event names that appear in the list on the right." TextWrapping="Wrap" Margin="2" />
		</Border>

		<diag:DiagramView
			MouseDoubleClick="diagram_MouseDoubleClick" 
            MouseDown="diagram_MouseDown" 
            MouseEnter="diagram_MouseEnter" 
            MouseLeave="diagram_MouseLeave" 
            MouseLeftButtonDown="diagram_MouseLeftButtonDown" 
            MouseLeftButtonUp="diagram_MouseLeftButtonUp" 
            MouseMove="diagram_MouseMove" 
            MouseRightButtonDown="diagram_MouseRightButtonDown" 
            MouseRightButtonUp="diagram_MouseRightButtonUp" 
            MouseUp="diagram_MouseUp" 
            PreviewMouseWheel="diagram_MouseWheel"
			ZoomFactorChanged="diagram_ZoomFactorChanged">

			<diag:Diagram
				Name="diagram" 
                ActionRecorded="diagram_ActionRecorded" 
                ActionRecording="diagram_ActionRecording" 
                ActionRedone="diagram_ActionRedone" 
                ActionUndone="diagram_ActionUndone" 
                BeginLoad="diagram_BeginLoad" 
                BoundsChanged="diagram_BoundsChanged" 
                CellClicked="diagram_CellClicked" 
                CellDoubleClicked="diagram_CellDoubleClicked" 
                CellTextEdited="diagram_CellTextEdited" 
                CellTextEditing="diagram_CellTextEditing" 
                Clicked="diagram_Clicked" 
                ContainerChildAdded="diagram_ContainerChildAdded" 
                ContainerChildRemoved="diagram_ContainerChildRemoved" 
                ContainerFolded="diagram_ContainerFolded" 
                ContainerUnfolded="diagram_ContainerUnfolded" 
                DefaultShapeChanged="diagram_DefaultShapeChanged" 
                DeserializeTag="diagram_DeserializeTag" 
                DestinationAnchorChanged="diagram_DestinationAnchorChanged" 
                DirtyChanged="diagram_DirtyChanged" 
                DoubleClicked="diagram_DoubleClicked" 
                DrawAdjustmentHandles="diagram_DrawAdjustmentHandles" 
                DrawAnchorPoint="diagram_DrawAnchorPoint" 
                DrawCell="diagram_DrawCell" 
                DrawLaneHeader="diagram_DrawLaneHeader" 
                DrawLink="diagram_DrawLink" 
                DrawNode="diagram_DrawNode" 
                EndLoad="diagram_EndLoad" 
                EnterInplaceEditMode="diagram_EnterInplaceEditMode" 
                ExpandButtonClicked="diagram_ExpandButtonClicked" 
                GroupDestroyed="diagram_GroupDestroyed" 
                HitTestAdjustmentHandles="diagram_HitTestAdjustmentHandles" 
                InitializeLink="diagram_InitializeLink" 
                InitializeNode="diagram_InitializeNode"  
                ItemAdded="diagram_ItemAdded" 
                ItemRemoved="diagram_ItemRemoved" 
                LeaveInplaceEditMode="diagram_LeaveInplaceEditMode" 
                LinkActivated="diagram_LinkActivated" 
                LinkClicked="diagram_LinkClicked" 
                LinkCreated="diagram_LinkCreated" 
                LinkCreating="diagram_LinkCreating" 
                LinkDeactivated="diagram_LinkDeactivated" 
                LinkDeleted="diagram_LinkDeleted" 
                LinkDeleting="diagram_LinkDeleting" 
                LinkDeselected="diagram_LinkDeselected" 
                LinkDoubleClicked="diagram_LinkDoubleClicked" 
				LinkHovered="diagram_LinkHovered"
                LinkModified="diagram_LinkModified" 
                LinkModifying="diagram_LinkModifying" 
                LinkPasted="diagram_LinkPasted"
				LinkPointerEnter="diagram_LinkPointerEnter"
				LinkPointerLeave="diagram_LinkPointerLeave"
                LinkRouted="diagram_LinkRouted" 
                LinkSelected="diagram_LinkSelected" 
                LinkSelecting="diagram_LinkSelecting" 
                LinkStartModifying="diagram_LinkStartModifying" 
                LinkTextEdited="diagram_LinkTextEdited" 
                LinkTextEditing="diagram_LinkTextEditing" 
                MeasureUnitChanged="diagram_MeasureUnitChanged" 
                NodeActivated="diagram_NodeActivated" 
                NodeClicked="diagram_NodeClicked" 
                NodeCreated="diagram_NodeCreated" 
                NodeCreating="diagram_NodeCreating"
                NodeDeactivated="diagram_NodeDeactivated"
                NodeDeleted="diagram_NodeDeleted"
                NodeDeleting="diagram_NodeDeleting"
                NodeDeselected="diagram_NodeDeselected"
                NodeDoubleClicked="diagram_NodeDoubleClicked"
				NodeHovered="diagram_NodeHovered"
                NodeModified="diagram_NodeModified" 
                NodeModifying="diagram_NodeModifying" 
                NodePasted="diagram_NodePasted" 
				NodePointerEnter="diagram_NodePointerEnter"
				NodePointerLeave="diagram_NodePointerLeave"
                NodeSelected="diagram_NodeSelected" 
                NodeSelecting="diagram_NodeSelecting" 
                NodeStartModifying="diagram_NodeStartModifying" 
                NodeTextEdited="diagram_NodeTextEdited" 
                NodeTextEditing="diagram_NodeTextEditing" 
                OriginAnchorChanged="diagram_OriginAnchorChanged"   
                SelectionChanged="diagram_SelectionChanged" 
                SelectionModified="diagram_SelectionModified" 
                SelectionModifying="diagram_SelectionModifying" 
                SerializeTag="diagram_SerializeTag"  
                TableSectionCollapsed="diagram_TableSectionCollapsed" 
                TableSectionExpanded="diagram_TableSectionExpanded" 
                TreeCollapsed="diagram_TreeCollapsed" 
                TreeExpanded="diagram_TreeExpanded" 
                TreeItemTextEditing="diagram_TreeItemTextEditing" 
                ValidateAnchorPoint="diagram_ValidateAnchorPoint" />
		</diag:DiagramView>

	</Grid>

</Window>
