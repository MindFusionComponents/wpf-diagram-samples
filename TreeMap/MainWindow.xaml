<Window x:Class="MindFusion.Diagramming.Wpf.Samples.CS.TreeMap.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:diag="http://mindfusion.eu/diagramming/wpf"
	Title="MindFusion.Diagramming Sample: Tree Map"
	Width="1024" Height="768" Icon="/App.ico">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<diag:DiagramView
			x:Name="diagramView"
			HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

			<diag:Diagram
				x:Name="diagram"
				BackBrush="White"
				DefaultShape="Rectangle">
			</diag:Diagram>
		</diag:DiagramView>

		<TextBlock Foreground="Gray" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0">Select a folder to see its content as a tree map.</TextBlock>
		<StackPanel Orientation="Horizontal" Margin="5" Grid.Row="1">
			<TextBlock Width="370" TextWrapping="Wrap">Click the button to select the folder to display. Note that displaying a large folder hierarchy may take considerable amount of time.</TextBlock>
			<Button Name="selectFolder" Margin="4" Click="selectFolder_Click">Select Folder</Button>
			<TextBlock Name="path" VerticalAlignment="Center"></TextBlock>
		</StackPanel>
	</Grid>

</Window>