<Window x:Class="MindFusion.Diagramming.Wpf.Samples.CS.DirTree.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:diag="http://mindfusion.eu/diagramming/wpf"
	Title="MindFusion.Diagramming Sample: Directory Tree" Width="1024" Height="768" Icon="/App.ico">

	<diag:DiagramView
		Behavior="Modify"
		ModificationStart="AutoHandles">

		<diag:Diagram 
              Name="dirDiagram" 
              LinkSegments="2" 
              AllowSelfLoops="False" 
              AllowUnanchoredLinks="True" 
              AllowLinksRepeat="False"
              BackBrush="WhiteSmoke" 
              ContainerMinimumSize="0,0" 
              AllowUnconnectedLinks="False"
              TreeCollapsed="OnTreeCollapsed"
              TreeExpanded="OnTreeExpanded">

			<diag:Diagram.DiagramLinkStyle>
				<Style TargetType="{x:Type diag:DiagramLink}">
					<Setter Property="Brush" Value="#FF78DCFF" />
					<Setter Property="Stroke" Value="DimGray" />
					<Setter Property="StrokeThickness" Value="0.4" />
				</Style>
			</diag:Diagram.DiagramLinkStyle>
			<diag:Diagram.ShapeNodeStyle>
				<Style TargetType="{x:Type diag:ShapeNode}">
					<Setter Property="FontSize" Value="10.75" />
					<Setter Property="Brush">
						<Setter.Value>
							<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
								<GradientStop Color="#FBF6B1" />
								<GradientStop Offset="1" Color="#D6BF60" />
							</LinearGradientBrush>
						</Setter.Value>
					</Setter>
					<Setter Property="Stroke" Value="#CAAF44" />
					<Setter Property="StrokeThickness" Value="2" />
				</Style>
			</diag:Diagram.ShapeNodeStyle>
		</diag:Diagram>
	</diag:DiagramView>

</Window>