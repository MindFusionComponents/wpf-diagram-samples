<Window x:Class="MindFusion.Diagramming.Wpf.Samples.CS.AnimatedLayout.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:diag="http://mindfusion.eu/diagramming/wpf"
	Title="MindFusion.Diagramming Sample: Animated Layout"
	Height="768" Width="1024" Icon="/App.ico">

	<Grid>

		<diag:DiagramView
			Behavior="Modify"
			ModificationStart="AutoHandles">

			<diag:Diagram
				Name="diagram"
				Bounds="0, 0, 1000, 1000"
				DefaultShape="Ellipse"
				AlignToGrid="False"
				ShapeHandlesStyle="MoveOnly"
				NodeModifying="OnNodeModifying"
				NodeModified="OnNodeModified">

				<diag:Diagram.ShapeNodeStyle>
					<Style TargetType="{x:Type diag:ShapeNode}">
						<Setter Property="Brush">
							<Setter.Value>
								<RadialGradientBrush GradientOrigin="0.3,0.4" Center="0.6,0.5" RadiusX="0.5" RadiusY="0.5">
									<GradientStop Color="LightBlue" Offset="0" />
									<GradientStop Color="LightSteelBlue" Offset="0.20" />
									<GradientStop Color="Blue" Offset="0.70" />
									<GradientStop Color="DarkBlue" Offset="1.0" />
								</RadialGradientBrush>
							</Setter.Value>
						</Setter>
					</Style>
				</diag:Diagram.ShapeNodeStyle>
			</diag:Diagram>
		</diag:DiagramView>

	</Grid>
</Window>
