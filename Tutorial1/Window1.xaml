<Window x:Class="MindFusion.Diagramming.Wpf.Samples.CS.Tutorial1.Window1"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:diag="http://mindfusion.eu/diagramming/wpf"
	Title="MindFusion.Diagramming Sample: Tutorial1" Height="768" Width="1024" Icon="/App.ico"
	Loaded="OnWindowLoaded">

	<Grid>
		<diag:DiagramView>
			<diag:Diagram Name="diagram"
				BackBrush="White"
				ShapeBrush="LightBlue"
				DefaultShape="Rectangle">
			</diag:Diagram>
		</diag:DiagramView>
	</Grid>

</Window>
