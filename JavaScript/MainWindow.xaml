<Window x:Class="MindFusion.Diagramming.Wpf.Samples.CS.JavaScript.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://mindfusion.eu/diagramming/wpf"
	Title="MindFusion.Diagramming sample: JavaScript Parser"
	Width="900" Height="600" Loaded="Window_Loaded" Icon="/App.ico">
    <Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition />
			<ColumnDefinition />
		</Grid.ColumnDefinitions>

		<DockPanel Grid.Column="0" Margin="0,0,4,0">
			<Border DockPanel.Dock="Bottom" BorderBrush="Gray" BorderThickness="0,1,1,0">
				<StackPanel Orientation="Horizontal">
					<Button Name="btnLoad" Margin="5,5,5,5" Click="btnLoad_Click">Load</Button>
					<Button Name="btnParse" Margin="0,5,5,5" Click="btnParse_Click">Parse</Button>
				</StackPanel>
			</Border>

			<!-- script source code -->
			<ScrollViewer>
				<TextBox Name="tbCode" AcceptsReturn="True" />
			</ScrollViewer>
		</DockPanel>

		<GridSplitter Width="4" />

		<Grid Grid.Column="1">
			<Grid.RowDefinitions>
				<RowDefinition />
				<RowDefinition />
			</Grid.RowDefinitions>
			
			<!-- script syntax tree -->
			<d:DiagramView Grid.Row="0" Margin="0, 0, 0, 4">
				<d:Diagram Name="syntaxTree"
					BackBrush="White">
				</d:Diagram>
			</d:DiagramView>
			
			<GridSplitter Height="4" ResizeDirection="Rows"
				HorizontalAlignment="Stretch" VerticalAlignment="Bottom" />

			<!-- script flowchart -->
			<d:DiagramView Grid.Row="1">
				<d:Diagram Name="flowchart"
					BackBrush="White">
				</d:Diagram>
			</d:DiagramView>
		</Grid>

	</Grid>
</Window>