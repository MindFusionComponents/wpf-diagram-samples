<Window x:Class="MindFusion.Diagramming.Wpf.Samples.CS.PredShapes.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:diag="http://mindfusion.eu/diagramming/wpf"
	Title="MindFusion.Diagramming Sample: Predefined Shapes"
	Width="880" Height="600" Icon="/App.ico">

	<DockPanel>
		<diag:DiagramView>
			<diag:Diagram
				Name="diagram" AlignToGrid="False" ShapeHandlesStyle="DashFrame" />
		</diag:DiagramView>
	</DockPanel>

</Window>
