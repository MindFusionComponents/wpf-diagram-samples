<Window x:Class="MindFusion.Diagramming.Wpf.Samples.CS.OrgChartEditor.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:diag="http://mindfusion.eu/diagramming/wpf"
	Title="MindFusion.Diagramming Sample: Custom Templates" Height="768" Width="1024" WindowState="Maximized"
	Loaded="OnWindowLoaded" Icon="/App.ico">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
	    <Grid>
		    <diag:DiagramView x:Name="diagramView">
			    <diag:Diagram x:Name="diagram" BackBrush="White" />
		    </diag:DiagramView>
		    <Slider Height="23" HorizontalAlignment="Left" Margin="28,0,0,28" Name="slider1" VerticalAlignment="Bottom" Width="150" Minimum="10" Maximum="400" Value="100" ValueChanged="slider1_ValueChanged" />
	    </Grid>
        <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Width="200">
            <TextBlock TextWrapping="Wrap" Margin="2">
                This sample demonstrates table nodes and how to create insertion effect using animated tree layout. 
                Right click on a parent node in the hierarchy to add a child node to the tree.
                Click on placeholder image to select an image file, or on text label to edit it.
            </TextBlock>
        </Border>

    </Grid>

</Window>
