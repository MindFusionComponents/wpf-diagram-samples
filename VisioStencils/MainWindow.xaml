<Window x:Class="MindFusion.Diagramming.Wpf.Samples.CS.VisioStencils.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:diag="http://mindfusion.eu/diagramming/wpf"
	xmlns:local="clr-namespace:MindFusion.Diagramming.Wpf.Samples.CS.VisioStencils"
	Title="MindFusion.Diagramming Sample: Visio Stencils"
	Height="768" Width="1024" Icon="/App.ico">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="200" />
			<ColumnDefinition />
		</Grid.ColumnDefinitions>

		<Menu Grid.ColumnSpan="2">
			<MenuItem Header="_File">
				<MenuItem Header="_Open Stencil..." Click="menuItemOpenStencil_Click" />
				<Separator />
				<MenuItem Header="E_xit" Click="menuItemExit_Click"  />
			</MenuItem>
		</Menu>

		<diag:NodeListView x:Name="nodeListView" Background="#94E7BD" BorderBrush="DimGray" BorderThickness="1" FontSize="9" Grid.Row="1" />

		<diag:Ruler Unit="Inch" Foreground="DimGray" TextColor="Black" FontSize="9" Grid.Column="1" Grid.Row="1">
			<diag:DiagramView x:Name="diagramView" AllowDrop="True">
				<diag:Diagram x:Name="diagram" ShowGrid="True" />
			</diag:DiagramView>
		</diag:Ruler>

	</Grid>

</Window>
